# Copie para o servidor: /etc/arteisis/arteisis-prod.env
# chmod 600 e dono jgrando (ou root). NUNCA commite o ficheiro real com senhas.

PROD_DB_URL=jdbc:postgresql://localhost:5432/arteisis_prod
PROD_DB_USER=arteisis_user
PROD_DB_PASSWORD=ALTERE_A_SENHA_DO_POSTGRES

PROD_CORS_ORIGINS=https://arteisis.jgnx.com.br
PROD_SERVER_PORT=4042

ARTEISIS_JWT_SECRET=GERE_COM_openssl_rand_base64_48
ARTEISIS_JWT_EXPIRATION_SECONDS=86400

# Gmail — conta de produção (App Password, não a senha normal)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=arteisisserigrafia@gmail.com
SPRING_MAIL_PASSWORD=COLE_A_APP_PASSWORD_AQUI

ARTEISIS_MAIL_FROM=arteisisserigrafia@gmail.com
ARTEISIS_MAIL_CONTACT_TO=arteisisserigrafia@gmail.com
