// Pipeline Jenkins — frontend ArteIsis (ficheiro no repositório ArteIsis-frontend)
// Parâmetro ENV: prod | hml

pipeline {
    agent any

    parameters {
        choice(name: 'ENV', choices: ['hml', 'prod'], description: 'Ambiente de deploy')
    }

    environment {
        SSH_HOST = '72.61.47.148'
        SSH_USER = 'jgrando'
        DEPLOY_DIR = "${params.ENV == 'prod' ? '/var/www/arteisis/prod/frontend' : '/var/www/arteisis/hml/frontend'}"
        NG_CONFIG = "${params.ENV == 'prod' ? 'production' : 'hml'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install & Build') {
            steps {
                sh 'npm ci'
                sh "npm run build -- --configuration=${NG_CONFIG}"
            }
        }

        stage('Deploy static') {
            steps {
                sh """
                    rsync -avz --delete dist/app/browser/ ${SSH_USER}@${SSH_HOST}:${DEPLOY_DIR}/
                """
            }
        }
    }
}
