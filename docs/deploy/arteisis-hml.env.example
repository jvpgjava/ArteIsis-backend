# Copie para o servidor: /etc/arteisis/arteisis-hml.env
# chmod 600. NUNCA commite o ficheiro real com senhas.

HML_DB_URL=jdbc:postgresql://localhost:5432/arteisis_hml
HML_DB_USER=arteisis_user
HML_DB_PASSWORD=ALTERE_A_SENHA_DO_POSTGRES

HML_CORS_ORIGINS=https://arteisis-hml.jgnx.com.br
HML_SERVER_PORT=4043

ARTEISIS_JWT_SECRET=OUTRA_CHAVE_DIFERENTE_DA_PROD
ARTEISIS_JWT_EXPIRATION_SECONDS=86400

# Gmail — homologação (mesma conta do desenvolvimento local)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=jgrando.dev@gmail.com
SPRING_MAIL_PASSWORD=COLE_A_APP_PASSWORD_AQUI

ARTEISIS_MAIL_FROM=jgrando.dev@gmail.com
ARTEISIS_MAIL_CONTACT_TO=jgrando.dev@gmail.com
